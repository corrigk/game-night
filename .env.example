# Copy to .env and fill in. Both values are public by design (they ship to the browser).
# Supabase dashboard -> Project Settings -> API. Use the anon / publishable key.
# NEVER put the service-role / secret key in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
